{
  "name": "lovers-nest",
  "version": "1.0.0",
  "private": true,
  "description": "只属于两个人的私密空间 —— 零依赖自托管情侣日记",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js && node test/render.js",
